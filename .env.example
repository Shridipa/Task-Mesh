# TaskMesh environment variables
# Copy this file to .env and replace every CHANGE_ME value. Never commit .env.

# ------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------
# development | production | test
# production enables strict validation: explicit secrets, explicit CORS
# origins, no automatic schema creation and no development API key.
ENVIRONMENT=production

# ------------------------------------------------------------------
# PostgreSQL (used by the API, the worker, the scheduler and Alembic)
# ------------------------------------------------------------------
POSTGRES_USER=taskmesh
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=taskmesh

# Async driver URL. Accepted schemes: postgresql+asyncpg, sqlite+aiosqlite.
# PostgreSQL URLs are used verbatim - they are never rewritten to SQLite.
DATABASE_URL=postgresql+asyncpg://taskmesh:CHANGE_ME_IN_PRODUCTION@postgres:5432/taskmesh

# Local development alternative (schema is created automatically):
# DATABASE_URL=sqlite+aiosqlite:///./taskmesh.db

# ------------------------------------------------------------------
# Redis (rate limiting, distributed scheduler lock, live log fan-out)
# ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------
# Signs short-lived access tokens (HS256). 32+ characters in production.
AUTH_JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_CHARACTERS
AUTH_JWT_ISSUER=taskmesh
AUTH_JWT_AUDIENCE=taskmesh-api
AUTH_TOKEN_TTL_SECONDS=3600

# Long-lived credentials exchanged at POST /auth/token for a JWT.
# Format: key:role:tenant,key2:role:tenant  (roles: admin, developer, viewer)
AUTH_API_KEYS=change-me-admin-key:admin:default,change-me-viewer-key:viewer:default

# Shared secret workers present in the X-Worker-Token header.
WORKER_SECRET=CHANGE_ME_IN_PRODUCTION

# ------------------------------------------------------------------
# HTTP surface
# ------------------------------------------------------------------
# Comma-separated allowed origins. Required in production; never "*".
CORS_ORIGINS=http://localhost:8080

# Maximum accepted request body size in bytes.
MAX_REQUEST_BYTES=2097152

# Public demo rate limit (per client, per window).
RATE_LIMIT_SUBMISSIONS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Serve /metrics/prometheus without a token. Only for networks where the API is
# not publicly reachable (the Compose stack keeps it on the internal network).
METRICS_PUBLIC=true

# ------------------------------------------------------------------
# Database and worker tuning
# ------------------------------------------------------------------
# Leave false in production: apply migrations with `alembic upgrade head`.
AUTO_CREATE_SCHEMA=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Run the worker/scheduler inside the API process (single-process development).
EMBEDDED_WORKER=false
EMBEDDED_SCHEDULER=false
WORKER_LEASE_SECONDS=900
JOB_POLL_SECONDS=1

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
# text | json
LOG_FORMAT=json
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# Compose ports and dashboards
# ------------------------------------------------------------------
FRONTEND_PORT=8080
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION
