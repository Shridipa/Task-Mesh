# Base origin of the TaskMesh API, with no trailing slash and no /api suffix.
#
# Local development: leave this unset — Vite proxies /api to http://127.0.0.1:8000.
# Vercel: set it in Project Settings → Environment Variables, for example
# VITE_API_BASE_URL=https://taskmesh-api.vercel.app
#
# Only public configuration belongs here: Vite inlines every VITE_* value into
# the browser bundle, so never put an API key, JWT secret or worker secret in it.
# VITE_API_BASE_URL=https://taskmesh-api.vercel.app
